{
  "expo": {
    "name": "Mossgrove",
    "slug": "nthcase-sample-react-native",
    "description": "Mossgrove, an NthCase sample app (spec 1.0).",
    "version": "1.0.0",
    "scheme": "nthcase-sample",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/launcher/icon.png",
    "backgroundColor": "#F7F9F7",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.nthcase.sample",
      "buildNumber": "1",
      "deploymentTarget": "17.0",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nthcase.sample",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/launcher/adaptive-foreground.png",
        "monochromeImage": "./assets/launcher/adaptive-monochrome.png",
        "backgroundColor": "#2E5E55"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "com.google.android.c2dm.permission.RECEIVE",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.READ_APP_BADGE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE",
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
        "com.anddoes.launcher.permission.UPDATE_COUNT",
        "com.majeur.launcher.permission.UPDATE_BADGE",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS",
        "com.oppo.launcher.permission.READ_SETTINGS",
        "com.oppo.launcher.permission.WRITE_SETTINGS",
        "me.everything.badger.permission.BADGE_COUNT_READ",
        "me.everything.badger.permission.BADGE_COUNT_WRITE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/launcher/notification.png",
          "color": "#2E5E55",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withMossgroveAndroid"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
