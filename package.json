{
  "name": "nthcase-sample-react-native",
  "version": "1.0.0",
  "private": true,
  "description": "Mossgrove, an NthCase sample app: React Native with Expo (spec 1.0).",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "derive": "node scripts/derive-assets.mjs",
    "prebuild": "expo prebuild --clean --no-install",
    "android:apk": "cd android && ./gradlew assembleRelease --no-daemon --max-workers=3",
    "ios:simulator": "bash scripts/build-ios-simulator.sh"
  },
  "dependencies": {
    "@expo/log-box": "^58.0.15",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ]
  }
}
